<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY. This file overrides the strict configuration in src/main and never
  ships in a release APK.

  A developer backend runs over plain HTTP on whatever address the machine happens to have:
  10.0.2.2 from an emulator, a DHCP-assigned 192.168.x.x from a real handset on the same
  Wi-Fi, sometimes a tethered address. Enumerating those in XML means editing this file
  every time the router hands out a different lease, so debug builds simply permit
  cleartext.

  src/main/res/xml/network_security_config.xml is the one that matters: it forbids cleartext
  outright, and that is the file a release build uses.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
