<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Session tokens and cached financial data must never leave the device in a backup
         or a device-to-device transfer. -->
    <cloud-backup>
        <exclude domain="file" path="datastore" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
