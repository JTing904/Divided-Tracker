<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Deliberately minimal: Compose owns the visual theme. This exists only so the launch
      window matches the app's background instead of flashing white.
    -->
    <style name="Theme.DividendStream" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
