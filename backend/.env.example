# Copy to .env and fill in. .env is git-ignored -- never commit real values.

# --- Database ---
DATABASE_URL=jdbc:postgresql://localhost:5432/dividend_stream
DATABASE_USERNAME=dividend_stream
DATABASE_PASSWORD=

# --- Security ---
# REQUIRED in production; at least 32 characters. Generate with:
#   openssl rand -base64 48
# The application refuses to start without it unless a local/dev/test profile is active.
JWT_SECRET=

# --- Cache ---
# caffeine (in-process, no dependency) or redis
CACHE_TYPE=caffeine
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Market data ---
# `mock` ships with the app. Real provider credentials stay here on the backend and are
# never sent to the Android client.
MARKET_DATA_PROVIDER=mock

# --- Web ---
SERVER_PORT=8080
# Comma-separated browser origins. Empty is correct when only the Android app calls the API.
CORS_ALLOWED_ORIGINS=
AUTH_RATE_LIMIT=20
LOG_LEVEL=INFO
